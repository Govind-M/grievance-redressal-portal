APP_NAME=CM Kerala Grievance API
APP_ENV=development
APP_DEBUG=true
DATABASE_URL=postgresql+psycopg://cm_user:change_me@localhost:5432/cm_kerala
# Local stays the default. Never replace DATABASE_URL to switch environments.
DATABASE_TARGET=local
SUPABASE_DATABASE_URL=
# Download the CA from your project's Database Settings over trusted HTTPS.
# Relative paths resolve against backend/, not the current working directory.
SUPABASE_SSLROOTCERT=../.local/certificates/supabase-root.crt
DB_POOL_SIZE=3
DB_MAX_OVERFLOW=2
DB_POOL_TIMEOUT_SECONDS=10
DB_POOL_RECYCLE_SECONDS=300
DB_CONNECT_TIMEOUT_SECONDS=5
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Generate once with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Keep the same secret across backend restarts and workers. Auth returns 503 when unset in development.
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ISSUER=cm-kerala-grievance-api
JWT_AUDIENCE=cm-kerala-grievance-client
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
AUTH_COOKIE_NAME=cmk_refresh_token
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_PATH=/api/v1/auth
# Omit domain for host-only cookies. Set Secure=true in production (required).
# AUTH_COOKIE_DOMAIN=
AUTH_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Recruitment prototype target only; not an official Kerala government SLA.
DEFAULT_RESOLUTION_DAYS=14
# Future AI setting, unused through Phase 4.
GEMINI_API_KEY=
AI_ENABLED=false
# Keep false until explicit approval of real provider requests. Never enable for pytest.
AI_LIVE_REQUESTS_ENABLED=false
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
AI_EMBEDDING_DIMENSIONS=768
AI_REQUEST_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=0
AI_MAX_OUTPUT_TOKENS=2048
AI_MAX_INPUT_CHARACTERS=50000
AI_DUPLICATE_CANDIDATE_LIMIT=5
AI_DUPLICATE_SIMILARITY_THRESHOLD=0.75
AI_REQUESTS_PER_MINUTE=5
AI_CACHE_SECONDS=60
# Supply locally; never commit populated credentials.
SEED_CITIZEN_PASSWORD=
SEED_CMO_PASSWORD=
SEED_OFFICER_PASSWORD=
# Integration tests migrate this dedicated empty test database.
# TEST_DATABASE_URL=postgresql+psycopg://cm_user:change_me@localhost:5432/cm_kerala_test

