APP_NAME=CM Kerala Grievance API
APP_ENV=development
APP_DEBUG=true
DATABASE_URL=postgresql+psycopg://cm_user:change_me@localhost:5432/cm_kerala
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Generate once with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Keep the same secret across backend restarts and workers. Auth returns 503 when unset in development.
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ISSUER=cm-kerala-grievance-api
JWT_AUDIENCE=cm-kerala-grievance-client
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
AUTH_COOKIE_NAME=cmk_refresh_token
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_PATH=/api/v1/auth
# Omit domain for host-only cookies. Set Secure=true in production (required).
# AUTH_COOKIE_DOMAIN=
AUTH_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Recruitment prototype target only; not an official Kerala government SLA.
DEFAULT_RESOLUTION_DAYS=14
# Future AI setting, unused through Phase 4.
GEMINI_API_KEY=
# Supply locally; never commit populated credentials.
SEED_CITIZEN_PASSWORD=
SEED_CMO_PASSWORD=
SEED_OFFICER_PASSWORD=
# Integration tests migrate this dedicated empty test database.
# TEST_DATABASE_URL=postgresql+psycopg://cm_user:change_me@localhost:5432/cm_kerala_test

